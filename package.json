{
  "name": "open-lemma",
  "version": "0.1.0",
  "private": true,
  "description": "A non-commercial digital library of open English-language course materials from the world's top mathematics departments.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "crawl": "tsx scripts/crawl.ts",
    "curate": "tsx scripts/curate.ts",
    "verify-links": "tsx scripts/verify-links.ts",
    "thumbnails": "tsx scripts/thumbnails.ts",
    "validate": "tsx scripts/validate.ts",
    "build": "npm run validate && npm run thumbnails && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "katex": "^0.19.1",
    "lenis": "^1.3.27",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
