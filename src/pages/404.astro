---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/strings';
import { href } from '../lib/paths';
import { tex } from '../lib/math';

// GitHub Pages serves one 404 for every path; it is rendered in English and
// links to both languages.
const s = t('en');
const tr = t('tr');
---

<Base lang="en" title="404">
  <section class="page-top nf">
    <div class="wrap">
      <div class="eq" set:html={tex(String.raw`\lim_{x \to \text{page}} f(x) = \text{undefined}`, true)} />
      <h1 class="display h-mega">{s.notFound.title}</h1>
      <p class="lede">{s.notFound.body} <span lang="tr">{tr.notFound.body}</span></p>
      <div class="ctas">
        <a class="btn btn-primary" href={href('en', 'library')} data-magnetic>{s.notFound.back}</a>
        <a class="btn" href={href('tr', 'library')} lang="tr" data-magnetic>{tr.notFound.back}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
  }
  .eq {
    color: var(--accent);
    font-size: clamp(1rem, 2.4vw, 1.6rem);
    margin-bottom: 24px;
    text-align: left;
  }
  .eq :global(.katex-display) {
    text-align: left;
    margin: 0;
  }
  .eq :global(.katex-display > .katex) {
    text-align: left;
  }
  .lede {
    margin-top: 24px;
    max-width: 52ch;
  }
  .lede span {
    display: block;
    margin-top: 8px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
</style>
