---
import Base from '../../layouts/Base.astro';
import TitleScene from '../../components/home/TitleScene.astro';
import DefinitionScene from '../../components/home/DefinitionScene.astro';
import DepartmentsRail from '../../components/home/DepartmentsRail.astro';
import FlowScene from '../../components/home/FlowScene.astro';
import ShelfScene from '../../components/home/ShelfScene.astro';
import QedScene from '../../components/home/QedScene.astro';
import { t, type Lang } from '../../i18n/strings';
import { langPaths } from '../../lib/routes';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---

<Base lang={lang}>
  <div class="home" data-home>
    <TitleScene lang={lang} />
    <DefinitionScene lang={lang} />
    <DepartmentsRail lang={lang} />
    <FlowScene lang={lang} />
    <ShelfScene lang={lang} />
    <QedScene lang={lang} />

    <aside class="margin" aria-hidden="true">
      <span class="mono m-label" data-margin-label>§ 1 · {s.home.margin.title}</span>
      <span class="m-rule"><span class="m-fill" data-margin-fill></span></span>
      <span class="mono m-page" data-margin-page>1 / 6</span>
    </aside>
  </div>
</Base>

<script>
  import { initHome } from '../../scripts/home';
  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    stop?.();
    stop = initHome();
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  /* With motion, each pinned scene ends under the next one, which slides
     over it like the next sheet of a manuscript. */
  .home:global(.is-staged) :global(.def-scene),
  .home:global(.is-staged) :global(.rail-scene) {
    position: relative;
    margin-top: -100svh;
    background: var(--bg);
    box-shadow: 0 -28px 50px -30px rgb(23 20 15 / 0.45);
  }
  .home:global(.is-staged) :global(.def-scene) {
    z-index: 2;
  }
  .home:global(.is-staged) :global(.rail-scene) {
    z-index: 3;
  }
  .home > :global(.flow-scene),
  .home > :global(.shelf-scene),
  .home > :global(.qed-scene) {
    position: relative;
    z-index: 4;
    background: var(--bg);
  }

  /* Running margin, like the running head of a printed paper. */
  .margin {
    display: none;
  }
  @media (min-width: 1200px) {
    .margin {
      position: fixed;
      left: 14px;
      top: 50%;
      z-index: 20;
      display: flex;
      align-items: center;
      gap: 14px;
      transform: translateY(-50%) rotate(180deg);
      writing-mode: vertical-rl;
      color: var(--fg-muted);
      pointer-events: none;
      transition: color 0.4s;
    }
    .margin[data-ink] {
      color: #b2aa9a;
    }
  }
  .m-rule {
    position: relative;
    width: 1px;
    height: 120px;
    background: currentColor;
    opacity: 0.4;
  }
  .m-fill {
    position: absolute;
    inset: 0;
    background: currentColor;
    transform-origin: 50% 100%;
    transform: scaleY(var(--p, 0));
  }
</style>
