---
import Base from '../../../layouts/Base.astro';
import Cover from '../../../components/Cover.astro';
import DocCard from '../../../components/DocCard.astro';
import LicenseBadge from '../../../components/LicenseBadge.astro';
import DocRows from '../../../components/DocRows.astro';
import { t, type Lang } from '../../../i18n/strings';
import { langCross } from '../../../lib/routes';
import { documents, universityBySlug, similarDocuments } from '../../../lib/data';
import { courseOfDoc, relatedDocuments } from '../../../lib/courses';
import { LICENSE_INFO, licenseLabel, type DocumentRecord } from '../../../lib/schema';
import { href, asset } from '../../../lib/paths';
import { inlineTex, plainTex } from '../../../lib/math';
import { topicName } from '../../../lib/topics';
import { bytes, date, authorsLine } from '../../../lib/format';

export function getStaticPaths() {
  return langCross(documents.map((doc) => ({ params: { id: doc.id }, props: { doc } })));
}

const lang = Astro.params.lang as Lang;
const { doc } = Astro.props as { doc: DocumentRecord };
const s = t(lang);
const uni = universityBySlug.get(doc.university);
const lic = LICENSE_INFO[doc.license];
const licUrl = doc.license_url ?? lic.url;
const similar = similarDocuments(doc);
const course = courseOfDoc.get(doc.id);
const pos = course ? course.docs.findIndex((d) => d.id === doc.id) : -1;
const prev = course && pos > 0 ? course.docs[pos - 1] : null;
const next = course && pos >= 0 && pos < course.docs.length - 1 ? course.docs[pos + 1] : null;
const related = course ? [] : relatedDocuments(doc);
const crumbCourse = course ? course.code ?? course.title : null;
const statusLabel = { ok: s.doc.statusOk, broken: s.doc.statusBroken, redirected: s.doc.statusRedirected, unchecked: s.doc.statusUnchecked }[doc.link_status];
const primary = doc.hosted && doc.file_path ? asset(doc.file_path) : doc.source_url;

const rows: [string, string | null, string?][] = [
  [s.doc.university, uni?.name ?? doc.university, href(lang, `universities/${doc.university}`)],
  [s.doc.course, [doc.course_code, doc.course_title].filter(Boolean).join(' — ') || null],
  [s.doc.level, s.levels[doc.level]],
  [s.doc.type, s.types[doc.type]],
  [s.doc.year, doc.year ? String(doc.year) : null],
  [s.doc.pages, doc.pages ? String(doc.pages) : null],
  [s.doc.fileSize, doc.hosted && doc.file_size ? bytes(doc.file_size) : null],
];
---

<Base lang={lang} title={plainTex(doc.title)} description={`${doc.authors.join(', ')} — ${uni?.name ?? ''}. ${s.types[doc.type]}, ${s.levels[doc.level]}.`}>
  <article class="doc">
    <div class="wrap">
      <nav class="crumbs mono" aria-label={s.a11y.breadcrumb}>
        <a href={href(lang, 'library')}>{s.nav.library}</a><span aria-hidden="true">/</span>
        <a href={href(lang, `universities/${doc.university}`)} lang="en">{uni?.name ?? doc.university}</a>
        {course && (
          <>
            <span aria-hidden="true">/</span>
            <a href={href(lang, `courses/${course.slug}`)} lang="en">{crumbCourse}</a>
          </>
        )}
      </nav>

      <div class="top">
        <div class="cover-col" data-reveal>
          <a href={primary} rel="noopener" target="_blank" tabindex="-1" aria-hidden="true">
            <Cover doc={doc} eager />
          </a>
        </div>

        <div class="main-col">
          <LicenseBadge doc={doc} lang={lang} />
          <h1 class="display title" data-rise set:html={inlineTex(doc.title)} />
          {doc.authors.length > 0 && <p class="by">{authorsLine(doc.authors)}</p>}
          {doc.description && <p class="desc muted" lang="en">{doc.description}</p>}

          <div class="actions">
            <a class="btn btn-primary" href={primary} target="_blank" rel="noopener">
              {doc.hosted ? s.doc.openPdf : s.doc.openSource}
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            {
              doc.hosted && (
                <a class="btn" href={doc.source_url} target="_blank" rel="noopener">
                  {s.doc.sourcePage}
                </a>
              )
            }
          </div>

          <p class="note mono-plain muted">{doc.hosted ? s.doc.hostedNote : s.doc.externalNote}</p>

          <ul class="topics" aria-label={s.doc.topics}>
            {
              doc.topics.map((tp) => (
                <li>
                  <a class="chip" href={href(lang, `topics/${tp}`)}>
                    {topicName(tp, lang)}
                  </a>
                </li>
              ))
            }
          </ul>

          <dl class="meta">
            {
              rows.filter(([, v]) => v != null).map(([k, v, link]) => (
                <div>
                  <dt class="mono muted">{k}</dt>
                  <dd>{link ? <a class="u" href={link}>{v}</a> : v}</dd>
                </div>
              ))
            }
            <div class="wide">
              <dt class="mono muted">{s.doc.license}</dt>
              <dd>
                {licUrl ? <a class="u" href={licUrl} rel="license noopener" target="_blank">{lic.label}</a> : licenseLabel(doc.license, s.licenseStatus)}
                {doc.license_evidence && (
                  <span class="mono-plain muted ev">
                    {s.doc.licenseEvidence}: <a class="u" href={doc.license_evidence} rel="noopener" target="_blank">{new URL(doc.license_evidence).host}</a>
                  </span>
                )}
              </dd>
            </div>
            <div class="wide">
              <dt class="mono muted">{s.doc.sourcePage}</dt>
              <dd class="break"><a class="u" href={doc.source_url} rel="noopener" target="_blank">{doc.source_url}</a></dd>
            </div>
            <div class="wide">
              <dt class="mono muted">{s.doc.checked}</dt>
              <dd>{date(doc.last_checked, lang)} · {statusLabel}</dd>
            </div>
          </dl>

          {
            course && (
              <section class="from" aria-labelledby="from-h">
                <div class="from-head">
                  <h2 id="from-h" class="display h-md">{s.course.fromThis}</h2>
                  <p class="mono muted" aria-label={`${pos + 1} / ${course.docs.length}`}>{s.course.position(pos + 1, course.docs.length)}</p>
                </div>
                <p class="from-course">
                  <a class="u" href={href(lang, `courses/${course.slug}`)} lang="en">
                    {[course.code, course.title].filter(Boolean).join(' · ')}
                  </a>
                </p>
                <div class="pn">
                  {prev ? (
                    <a class="pn-a" href={href(lang, `doc/${prev.id}`)} rel="prev">
                      <span class="mono muted">← {s.course.previous}</span>
                      <span class="pn-t" set:html={inlineTex(course.labels[prev.id])} />
                    </a>
                  ) : <span class="pn-gap" aria-hidden="true" />}
                  {next ? (
                    <a class="pn-a pn-next" href={href(lang, `doc/${next.id}`)} rel="next">
                      <span class="mono muted">{s.course.next} →</span>
                      <span class="pn-t" set:html={inlineTex(course.labels[next.id])} />
                    </a>
                  ) : <span class="pn-gap" aria-hidden="true" />}
                </div>
                <a class="btn" href={href(lang, `courses/${course.slug}`)}>
                  {s.course.allDocs} <span class="arrow" aria-hidden="true">→</span>
                </a>
              </section>
            )
          }

          {
            related.length > 0 && (
              <section class="from" aria-labelledby="rel-h">
                <h2 id="rel-h" class="display h-md">{s.course.related}</h2>
                <DocRows rows={related.map((d) => ({ doc: d, label: d.title }))} lang={lang} showType />
              </section>
            )
          }
        </div>
      </div>

      {
        similar.length > 0 && (
          <section class="similar" aria-labelledby="sim-h">
            <h2 id="sim-h" class="display h-lg" data-split>
              {s.doc.similar}
            </h2>
            <div class="grid">
              {similar.map((d) => (
                <div data-reveal>
                  <DocCard doc={d} lang={lang} />
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</Base>

<style>
  .doc {
    padding-top: calc(var(--header-h) + clamp(32px, 6vw, 80px));
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--fg-muted);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .crumbs a:hover {
    color: var(--fg);
  }
  .top {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
  }
  @media (min-width: 820px) {
    .top {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
    .cover-col {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .cover-col {
    max-width: 420px;
  }
  /* The document as a small stack of sheets: the first page on top, two
     more peeking out behind it. */
  .cover-col > a {
    position: relative;
    display: block;
    isolation: isolate;
  }
  .cover-col > a::before,
  .cover-col > a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #fbf8f1;
    box-shadow: var(--shadow-sheet);
    transition: transform 0.7s var(--ease-out);
  }
  .cover-col > a::before {
    transform: rotate(2.4deg) translate(8px, 4px);
  }
  .cover-col > a::after {
    transform: rotate(-1.6deg) translate(-6px, 6px);
  }
  .cover-col > a:hover::before {
    transform: rotate(5deg) translate(18px, 6px);
  }
  .cover-col > a:hover::after {
    transform: rotate(-4deg) translate(-16px, 10px);
  }
  .title {
    font-size: clamp(2.6rem, 6.4vw, 6rem);
    margin-top: 20px;
    text-wrap: balance;
  }
  .by {
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    margin-top: 20px;
  }
  .desc {
    margin-top: 16px;
    max-width: 62ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .note {
    margin-top: 18px;
    max-width: 62ch;
    line-height: 1.6;
  }
  .topics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 28px;
  }
  .topics .chip {
    height: 32px;
  }
  .topics .chip:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(20px, 3vw, 48px);
    margin-top: clamp(36px, 5vw, 56px);
    border-top: 1px solid var(--line);
    max-width: 760px;
  }
  .meta > div {
    display: grid;
    gap: 6px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .meta > .wide {
    grid-column: 1 / -1;
    grid-template-columns: minmax(110px, 2fr) 5fr;
    gap: 16px;
  }
  @media (max-width: 519px) {
    .meta > .wide {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }
  .meta dd {
    min-width: 0;
  }
  .break {
    overflow-wrap: anywhere;
  }
  .ev {
    display: block;
    margin-top: 4px;
  }
  .u {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .u:hover {
    text-decoration-color: var(--accent);
  }
  .from {
    margin-top: clamp(40px, 6vw, 64px);
    max-width: 760px;
  }
  .from-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .from-course {
    margin-top: 6px;
    color: var(--fg-muted);
  }
  .pn {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0 22px;
  }
  .pn-a {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 18px;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    transition: border-color 0.25s;
  }
  .pn-a:hover {
    border-color: var(--accent);
  }
  .pn-next {
    text-align: right;
  }
  .pn-t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .pn-a:hover .pn-t {
    color: var(--accent);
  }
  @media (max-width: 519px) {
    .pn {
      grid-template-columns: minmax(0, 1fr);
    }
    .pn-next {
      text-align: left;
    }
    .pn-gap {
      display: none;
    }
  }
  .similar {
    margin-top: clamp(80px, 12vw, 160px);
  }
  .similar .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px clamp(14px, 2.4vw, 28px);
    margin-top: 48px;
  }
  @media (min-width: 1000px) {
    .similar .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
