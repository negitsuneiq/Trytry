---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import DocCard from '../../components/DocCard.astro';
import LoadMore from '../../components/LoadMore.astro';
import EmptyState from '../../components/EmptyState.astro';
import { t, type Lang } from '../../i18n/strings';
import { langPaths } from '../../lib/routes';
import { documents, universities, universityBySlug, usedTopics } from '../../lib/data';
import { TOPICS, topicName } from '../../lib/topics';
import { DOC_TYPES, LEVELS, licenseLabel, type License } from '../../lib/schema';
import { plainTex } from '../../lib/math';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);

const topicOptions = usedTopics.length ? usedTopics : TOPICS;
const uniOptions = universities.filter((u) => documents.some((d) => d.university === u.slug));
const licenses = [...new Set(documents.map((d) => d.license))].sort() as License[];
const types = DOC_TYPES.filter((ty) => documents.some((d) => d.type === ty));

// Compact search records; topic names in both languages so either query works.
const index = documents.map((d) => ({
  id: d.id,
  title: plainTex(d.title),
  authors: d.authors.join(' '),
  course: [d.course_code, d.course_title].filter(Boolean).join(' '),
  topics: d.topics.map((tp) => `${topicName(tp, 'en')} ${topicName(tp, 'tr')}`).join(' '),
  university: universityBySlug.get(d.university)?.name ?? d.university,
}));

const groups = [
  { key: 'u', label: s.library.university, options: uniOptions.map((u) => ({ value: u.slug, label: u.name, en: true })) },
  { key: 't', label: s.library.topic, options: topicOptions.map((tp) => ({ value: tp.slug, label: tp[lang] })) },
  { key: 'l', label: s.library.level, options: LEVELS.map((l) => ({ value: l, label: s.levels[l] })) },
  { key: 'ty', label: s.library.type, options: types.map((ty) => ({ value: ty, label: s.types[ty] })) },
  { key: 'li', label: s.library.license, options: licenses.map((l) => ({ value: l, label: licenseLabel(l, s.licenseStatus) })) },
].filter((g) => g.options.length > 0);
---

<Base lang={lang} title={s.library.title} description={s.library.lede}>
  <section class="page">
    <div class="wrap">
      <SectionHead index="∑" title={s.library.title} lede={s.library.lede} level="h1" />

      {
        documents.length === 0 ? (
          <EmptyState lang={lang} />
        ) : (
          <div class="lib" data-library>
            <div class="searchbar">
              <label class="search">
                <span class="sr-only">{s.library.search}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.4" />
                </svg>
                <input type="search" name="q" placeholder={s.library.searchPlaceholder} autocomplete="off" enterkeyhint="search" data-q />
              </label>
              <div class="fs" data-fs>
                <button class="btn btn-sm fs-toggle" type="button" aria-expanded="false" aria-controls="lib-panel" data-fs-toggle>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h10M18 7h2M4 17h2M10 17h10" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="16" cy="7" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="8" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                  <span>{s.library.filterSort}</span>
                  <span class="badge mono" data-active-count hidden />
                </button>

                <div id="lib-panel" class="panel" role="dialog" aria-label={s.library.filterSort} tabindex="-1" hidden data-panel>
                  <div class="panel-head">
                    <h2 class="mono">{s.library.filterSort}</h2>
                    <button class="close" type="button" aria-label={s.a11y.close} data-fs-close>
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5" />
                      </svg>
                    </button>
                  </div>

                  <div class="panel-body">
                    <fieldset class="group">
                      <legend class="mono">{s.library.sort}</legend>
                      <div class="opts">
                        {[
                          ['relevance', s.library.sortRelevance],
                          ['newest', s.library.sortNewest],
                          ['title', s.library.sortTitle],
                          ['rank', s.library.sortRank],
                        ].map(([value, label], i) => (
                          <label class="opt">
                            <input type="radio" name="s" value={value} checked={i === 0} data-sort />
                            <span>{label}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>

                    <label class="switch">
                      <input type="checkbox" data-hosted />
                      <span class="track" aria-hidden="true">
                        <span class="thumb" />
                      </span>
                      <span>{s.library.hostedOnly}</span>
                    </label>

                    {groups.map((g) => (
                      <fieldset class="group">
                        <legend class="mono">{g.label}</legend>
                        <div class="opts">
                          {g.options.map((o) => (
                            <label class="opt">
                              <input type="checkbox" name={g.key} value={o.value} data-facet={g.key} />
                              <span lang={'en' in o ? 'en' : undefined}>{o.label}</span>
                            </label>
                          ))}
                        </div>
                      </fieldset>
                    ))}
                  </div>

                  <div class="panel-foot">
                    <button class="btn btn-sm" type="button" data-clear>
                      {s.library.clear}
                    </button>
                    <button class="btn btn-sm btn-primary" type="button" data-fs-close data-show-results data-template-one={s.library.showResults(1)} data-template={s.library.showResults(2)}>
                      {s.library.showResults(documents.length)}
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="status">
              <p class="mono muted count" aria-live="polite" data-count-label data-template-one={s.library.results(1)} data-template={s.library.results(2)}>
                {s.library.results(documents.length)}
              </p>
              <ul class="active" data-active data-remove={s.library.removeFilter} />
            </div>

            <div class="results">
              <div class="grid" data-grid>
                {documents.map((d) => (
                  <DocCard doc={d} lang={lang} heading="h2" filterable />
                ))}
              </div>
              <LoadMore lang={lang} />
              <p class="none" hidden data-none>
                {s.library.noResults}
              </p>
            </div>
            <script type="application/json" id="lib-index" set:html={JSON.stringify(index)} />
          </div>
        )
      }
    </div>
  </section>
</Base>

<script>
  import { initLibrary } from '../../scripts/library';
  document.addEventListener('astro:page-load', initLibrary);
</script>

<style>
  .page {
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 112px));
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  /* Grid, not wrapping flex: rows stay put while fonts load (no CLS). */
  .searchbar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px clamp(14px, 2vw, 28px);
    padding: 14px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s;
  }
  .search:focus-within {
    border-color: var(--accent);
  }
  .search svg {
    width: 22px;
    height: 22px;
    color: var(--fg-muted);
    flex: none;
  }
  .search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    padding: 8px 0;
  }
  .search input::placeholder {
    color: var(--fg-faint);
  }

  /* Filter & sort: one control, one panel. Needs JS, so it is hidden without it. */
  html:not(.js) .fs {
    display: none;
  }
  .fs-toggle {
    white-space: nowrap;
    gap: 10px;
    --h: 44px;
  }
  .fs-toggle svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.6875rem;
  }
  .badge[hidden] {
    display: none;
  }
  .fs-toggle:hover .badge,
  .fs-toggle:focus-visible .badge {
    background: var(--accent-ink);
    color: var(--accent);
  }
  .fs-toggle[aria-expanded='true'] {
    border-color: var(--fg);
  }
  .panel {
    position: absolute;
    top: calc(100% - 2px);
    right: 0;
    z-index: 80;
    width: min(720px, 100%);
    max-height: calc(100vh - var(--header-h) - 120px);
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-sheet);
  }
  .panel[hidden] {
    display: none;
  }
  .panel:focus {
    outline: 0;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px 6px 24px;
    border-bottom: 1px solid var(--line);
  }
  .panel-head h2 {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--fg-muted);
  }
  .close:hover {
    color: var(--accent);
  }
  .close svg {
    width: 20px;
    height: 20px;
  }
  .panel-body {
    display: grid;
    gap: 26px;
    padding: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .panel-foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 24px;
    border-top: 1px solid var(--line);
  }
  .group {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    color: var(--fg-muted);
    margin-bottom: 12px;
    padding: 0;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .opt {
    position: relative;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .opt span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--fg-muted);
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .opt:hover span {
    color: var(--fg);
    border-color: var(--fg-muted);
  }
  .opt input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .opt input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .switch {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    position: relative;
    font-size: 0.92rem;
  }
  .switch input {
    position: absolute;
    opacity: 0;
    width: 44px;
    height: 26px;
  }
  .track {
    width: 44px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    position: relative;
    flex: none;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--fg-muted);
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s;
  }
  .switch input:checked + .track {
    background: var(--accent);
    border-color: var(--accent);
  }
  .switch input:checked + .track .thumb {
    transform: translateX(18px);
    background: var(--accent-ink);
  }
  .switch input:focus-visible + .track {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* On phones the panel is a full-width sheet under the header. */
  @media (max-width: 719px) {
    .panel {
      position: fixed;
      inset: var(--header-h) 0 0;
      width: auto;
      max-height: none;
      border-width: 1px 0 0;
      box-shadow: none;
    }
    .panel-head {
      padding-left: var(--gutter);
    }
    .panel-body {
      padding: 20px var(--gutter);
    }
    .panel-foot {
      padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom));
    }
    .panel-foot .btn {
      flex: 1;
      justify-content: center;
    }
  }

  /* Count and removable chips share one row; min-height keeps it from jumping. */
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    min-height: 34px;
    margin: 20px 0 28px;
  }
  .active {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .active :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px 0 14px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-size: 0.82rem;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .active :global(button:hover),
  .active :global(button:focus-visible) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .active :global(svg) {
    width: 10px;
    height: 10px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px) clamp(14px, 2.4vw, 28px);
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1500px) {
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .grid > :global([hidden]) {
    display: none;
  }
  .none {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--fg-muted);
    padding: 48px 0;
  }
</style>
