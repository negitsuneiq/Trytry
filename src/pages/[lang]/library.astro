---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import LibraryBrowser from '../../components/LibraryBrowser.astro';
import { t, type Lang } from '../../i18n/strings';
import { langPaths } from '../../lib/routes';
import { href } from '../../lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---

<Base lang={lang} title={s.library.title} description={s.library.lede}>
  <section class="page">
    <div class="wrap">
      <SectionHead index="∑" title={s.library.title} lede={s.library.lede} level="h1">
        <p class="mono"><a class="link-u" href={href(lang, 'courses')}>{s.course.seeAll} →</a></p>
      </SectionHead>
      <LibraryBrowser lang={lang} urlState />
    </div>
  </section>
</Base>

<style>
  /* Tighter than other pages: the search field is the page's tool and belongs in the first screen. */
  .page {
    padding-top: calc(var(--header-h) + clamp(28px, 3.4vw, 44px));
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  .page :global(.sec-head) {
    gap: 12px;
    margin-bottom: clamp(18px, 2.4vw, 28px);
  }
  .page :global(.sec-index) {
    margin-bottom: 10px;
  }
  .page :global(.sec-head .side) {
    gap: 10px;
  }
</style>
