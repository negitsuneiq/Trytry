---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import TopicGrid from '../../../components/TopicGrid.astro';
import { t, type Lang } from '../../../i18n/strings';
import { langPaths } from '../../../lib/routes';
import { TOPICS } from '../../../lib/topics';
import { courses } from '../../../lib/courses';
import { href } from '../../../lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---

<Base lang={lang} title={s.topicsPage.title} description={s.topicsPage.lede}>
  <section class="page-top">
    <div class="wrap">
      <SectionHead index="MSC2020" title={s.topicsPage.title} lede={s.topicsPage.lede} level="h1" />
      <div class="tiles">
        <TopicGrid topics={TOPICS} lang={lang} closing={{ href: href(lang, 'courses'), label: `${s.course.seeAll} →`, sub: s.coursesPage.count(courses.length) }} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* The line art fades out towards the bottom, where each tile's name and count
     sit, and a soft halo keeps the index number legible. Selectors reach into
     TopicGrid, whose own file is shared with other pages. */
  .tiles :global(.topics li a svg) {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 20%, transparent 58%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 20%, transparent 58%);
  }
  .tiles :global(.topics li a .n),
  .tiles :global(.topics li a .name),
  .tiles :global(.topics li a .count) {
    text-shadow:
      0 0 8px var(--bg),
      0 0 16px var(--bg);
  }
</style>
