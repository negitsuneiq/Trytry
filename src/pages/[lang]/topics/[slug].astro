---
import Base from '../../../layouts/Base.astro';
import DocCard from '../../../components/DocCard.astro';
import CardConfig from '../../../components/CardConfig.astro';
import LoadMore from '../../../components/LoadMore.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { t, type Lang } from '../../../i18n/strings';
import { langCross } from '../../../lib/routes';
import { TOPICS, type Topic } from '../../../lib/topics';
import { docsForTopic, booksForTopic } from '../../../lib/data';
import { coverSvg, COVER_VIEWBOX } from '../../../lib/cover';
import { href } from '../../../lib/paths';
import { authorsLine } from '../../../lib/format';

export function getStaticPaths() {
  return langCross(TOPICS.map((topic) => ({ params: { slug: topic.slug }, props: { topic } })));
}

/** Cards rendered into the page; the rest come from /docs-index.json on demand. */
const FIRST = 24;
const lang = Astro.params.lang as Lang;
const { topic } = Astro.props as { topic: Topic };
const s = t(lang);
const docs = docsForTopic(topic.slug).sort((a, b) => a.title.localeCompare(b.title));
const topicBooks = booksForTopic(topic.slug);
const other = lang === 'tr' ? 'en' : 'tr';
---

<Base lang={lang} title={topic[lang]} description={`${topic[lang]} — ${s.home.docsCount(docs.length)}.`}>
  <section class="page-top">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="mono muted"><a href={href(lang, 'topics')}>{s.nav.topics}</a></p>
          <h1 class="display h-xl name" data-rise>{topic[lang]}</h1>
          <p class="lede"><span lang={other}>{topic[other]}</span> · {s.home.docsCount(docs.length)}</p>
        </div>
        <svg class="art" viewBox={COVER_VIEWBOX} aria-hidden="true" set:html={coverSvg(topic.slug, topic.motif)} />
      </div>

      <div class="docs">
        {
          docs.length ? (
            <div class="card-grid" data-paged="topic" data-slug={topic.slug} data-total={docs.length}>
              {docs.slice(0, FIRST).map((d) => (
                <div data-reveal>
                  <DocCard doc={d} lang={lang} heading="h2" />
                </div>
              ))}
            </div>
            <LoadMore lang={lang} shown={FIRST} total={docs.length} fallbackHref={`${href(lang, 'library')}?t=${topic.slug}`} />
          ) : (
            <EmptyState lang={lang} />
          )
        }
      </div>

      {
        topicBooks.length > 0 && (
          <section class="books" aria-labelledby="topic-books">
            <h2 id="topic-books" class="display h-md">{s.booksPage.onTopic}</h2>
            <ul>
              {topicBooks.slice(0, 12).map((bk) => (
                <li>
                  <a class="title" href={bk.home_url} target="_blank" rel="noopener" lang="en" aria-label={`${bk.title} ${s.booksPage.newTab}`}>
                    {bk.title}<span aria-hidden="true"> ↗</span>
                  </a>
                  {bk.authors.length > 0 && <span class="authors" lang="en">{authorsLine(bk.authors)}</span>}
                </li>
              ))}
            </ul>
            <p class="mono">
              <a class="link-u" href={`${href(lang, 'books')}?topic=${topic.slug}`}>
                {s.booksPage.allOnTopic} ({topicBooks.length}) →
              </a>
            </p>
          </section>
        )
      }
    </div>
  </section>
  <CardConfig lang={lang} />
</Base>

<script>
  import { initPagers } from '../../../scripts/pager';
  document.addEventListener('astro:page-load', initPagers);
</script>

<style>
  .head {
    display: grid;
    gap: 32px;
    align-items: end;
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1fr 280px;
    }
  }
  .name {
    margin: 14px 0 18px;
    hyphens: auto;
  }
  .head a:hover {
    color: var(--fg);
  }
  .art {
    width: 100%;
    max-width: 280px;
    border: 1px solid var(--line);
    stroke-width: 1;
  }
  .docs {
    margin-top: clamp(48px, 7vw, 96px);
  }
  .books {
    margin-top: clamp(56px, 8vw, 112px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 20px;
  }
  .books ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 72ch;
  }
  .books li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .books .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .books .title:hover {
    color: var(--accent);
  }
  .books .authors {
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
</style>
