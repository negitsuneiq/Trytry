---
import type { DocumentRecord } from '../lib/schema';
import { t, type Lang } from '../i18n/strings';
import { href } from '../lib/paths';
import { inlineTex } from '../lib/math';
import { topicName } from '../lib/topics';
import { universityBySlug } from '../lib/data';
import { authorsLine } from '../lib/format';
import Cover from './Cover.astro';
import LicenseBadge from './LicenseBadge.astro';

interface Props {
  doc: DocumentRecord;
  lang: Lang;
  /** Extra attributes for client-side filtering on the library page. */
  filterable?: boolean;
  /** Heading level for the title, so the page outline never skips a level. */
  heading?: 'h2' | 'h3';
}
const { doc, lang, filterable = false, heading = 'h3' } = Astro.props;
const H = heading;
const s = t(lang);
const uni = universityBySlug.get(doc.university);
const data = filterable
  ? {
      'data-id': doc.id,
      'data-university': doc.university,
      'data-topics': doc.topics.join(' '),
      'data-level': doc.level,
      'data-type': doc.type,
      'data-license': doc.license,
      'data-hosted': String(doc.hosted),
      'data-year': String(doc.year ?? 0),
      'data-accessed': doc.accessed_at,
      'data-rank': String(uni?.rank ?? 99),
      'data-title': doc.title.toLowerCase(),
    }
  : {};
---

<article class="card" {...data}>
  <a href={href(lang, `doc/${doc.id}`)} class="hit">
    <Cover doc={doc} />
    <div class="body">
      <p class="mono meta">
        <span lang="en">{uni?.name ?? doc.university}</span>
        <span aria-hidden="true">·</span>
        <span>{s.types[doc.type]}</span>
      </p>
      <H class="title" set:html={inlineTex(doc.title)} />
      {doc.authors.length > 0 && <p class="authors">{authorsLine(doc.authors)}</p>}
      <p class="topics mono">{doc.topics.map((tp) => topicName(tp, lang)).join(' / ')}</p>
    </div>
  </a>
  <div class="foot">
    <LicenseBadge doc={doc} lang={lang} />
    <span class="mono lvl">{s.levels[doc.level]}{doc.year ? ` · ${doc.year}` : ''}</span>
  </div>
</article>

<style>
  .card {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .hit {
    display: grid;
    gap: 16px;
  }
  .hit :global(.cover) {
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out),
      border-color 0.5s;
  }
  .hit:hover :global(.cover),
  .hit:focus-visible :global(.cover) {
    transform: translateY(-6px) rotate(-1.2deg);
    border-color: rgb(var(--accent-rgb) / 0.5);
  }
  .hit:hover :global(.cover[data-kind='thumb']),
  .hit:focus-visible :global(.cover[data-kind='thumb']) {
    box-shadow: 0 2px 2px rgb(23 20 15 / 0.06), 0 18px 30px -12px rgb(23 20 15 / 0.35);
  }
  .hit :global(.cover svg) {
    transition: transform 1.1s var(--ease-out);
  }
  .hit:hover :global(.cover svg) {
    transform: scale(1.045);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    color: var(--fg-muted);
    font-size: 0.6875rem;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    line-height: 1.08;
    margin-top: 8px;
    text-wrap: pretty;
    transition: color 0.3s;
  }
  .hit:hover .title {
    color: var(--accent);
  }
  .authors {
    font-size: 0.92rem;
    color: var(--fg-muted);
    margin-top: 6px;
  }
  .topics {
    color: var(--fg-faint);
    margin-top: 10px;
    font-size: 0.6875rem;
    color: var(--fg-muted);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    margin-top: auto;
  }
  .lvl {
    font-size: 0.6875rem;
    color: var(--fg-muted);
  }
</style>
