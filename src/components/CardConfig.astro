---
// Localised labels for client-rendered cards (scripts/cards.ts).
import { t, type Lang } from '../i18n/strings';
import { asset, href } from '../lib/paths';
import { documents, universities } from '../lib/data';
import { TOPICS } from '../lib/topics';
import { licenseLabel } from '../lib/schema';
import type { CardCfg } from '../lib/cardRec';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const cfg: CardCfg = {
  lang,
  index: asset('docs-index.json'),
  doc: href(lang, 'doc'),
  thumbs: asset('thumbs'),
  unis: Object.fromEntries(universities.map((u) => [u.slug, [u.name, u.rank]])),
  topics: Object.fromEntries(TOPICS.map((tp) => [tp.slug, [tp.en, tp.tr, tp.motif, tp.msc[0]]])),
  types: s.types,
  levels: s.levels,
  licenses: Object.fromEntries([...new Set(documents.map((d) => d.license))].map((l) => [l, licenseLabel(l, s.licenseStatus)])),
  course: href(lang, 'courses'),
  courseWord: s.course.word,
  hosted: s.doc.hosted,
  external: s.doc.external,
  ui: { error: s.pager.error },
  save: { add: s.saved.save, remove: s.saved.unsave },
};
---

<script type="application/json" id="card-cfg" set:html={JSON.stringify(cfg)} />
