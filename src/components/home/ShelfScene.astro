---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { t, type Lang } from '../../i18n/strings';
import { href, asset } from '../../lib/paths';
import { shelfBooks, spineColour } from '../../lib/home';
import { universityBySlug } from '../../lib/data';
import { authorsLine } from '../../lib/format';
import { licenseLabel } from '../../lib/schema';
import { plainTex } from '../../lib/math';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const books = shelfBooks.slice(0, 12);
const maxPages = Math.max(...books.map((b) => b.pages ?? 0), 1);
const thumb = (id: string) => `thumbs/${id}.webp`;
const has = (id: string) => existsSync(join(process.cwd(), 'public', thumb(id)));
---

<section class="scene shelf-scene" data-scene="shelf" data-label={s.home.margin.shelf} aria-labelledby="shelf-h">
  <div class="wrap">
    <header class="head">
      <h2 id="shelf-h">
        <span class="thm">{s.home.shelfLabel} <b>4.</b></span>
        <span class="display h-lg">{s.home.shelfTitle}</span>
      </h2>
      <p class="lede">{s.home.shelfLede}</p>
    </header>

    <div class="shelf" data-shelf>
      <div class="case">
        <ul class="spines" data-spines>
          {
            books.map((d, i) => {
              const p = d.pages ?? 100;
              const code = d.course_code ?? universityBySlug.get(d.university)?.name ?? '';
              return (
                <li style={`--h:${(0.62 + (p / maxPages) * 0.38).toFixed(3)};--w:${(52 + (p / maxPages) * 30).toFixed(0)}px`}>
                  <a class:list={['spine', `c-${spineColour(d.id)}`]} href={href(lang, `doc/${d.id}`)} data-book={i} aria-describedby={`book-${i}`}>
                    <span class="band" aria-hidden="true" />
                    <span class="sp-title">{plainTex(d.title)}</span>
                    <span class="sp-code mono" lang="en">
                      {code}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="board" aria-hidden="true"></div>
      </div>

      <div class="preview" data-preview>
        {
          books.map((d, i) => {
            const uni = universityBySlug.get(d.university);
            return (
              <article class="card" id={`book-${i}`} data-card={i} hidden={i !== 0}>
                <a href={href(lang, `doc/${d.id}`)} class="cover sheet" tabindex="-1" aria-hidden="true">
                  {has(d.id) && <img src={asset(thumb(d.id))} alt="" width="600" height="800" loading="lazy" decoding="async" />}
                </a>
                <div class="meta">
                  <p class="mono muted" lang="en">
                    {uni?.name}
                    {d.course_code && ` · ${d.course_code}`}
                  </p>
                  <h3 class="display">
                    <a href={href(lang, `doc/${d.id}`)}>{plainTex(d.title)}</a>
                  </h3>
                  {d.authors.length > 0 && <p class="by">{authorsLine(d.authors)}</p>}
                  <p class="mono muted facts">
                    {s.types[d.type]} · {d.pages ? s.home.pages(d.pages) : ''} · {licenseLabel(d.license, s.licenseStatus)}
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .shelf-scene {
    padding-block: calc(var(--header-h) + clamp(48px, 8vw, 120px)) clamp(64px, 10vw, 140px);
  }
  .head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(36px, 6vw, 72px);
  }
  @media (min-width: 1000px) {
    .head {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
  }
  .head h2 {
    display: grid;
    gap: 16px;
    font-weight: 400;
  }
  .shelf {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }
  @media (min-width: 1000px) {
    .shelf {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .case {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    padding-top: 40px;
    scrollbar-width: none;
  }
  .spines {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    list-style: none;
    padding: 0 0 0 4px;
    height: clamp(300px, 44vh, 420px);
  }
  .spines li {
    flex: none;
    height: calc(var(--h) * 100%);
    width: var(--w);
  }
  .spine {
    --c: var(--fg);
    --t: var(--bg);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 18px 0 14px;
    background: var(--c);
    color: var(--t);
    border-radius: 3px 3px 0 0;
    box-shadow:
      inset 3px 0 0 rgb(255 255 255 / 0.08),
      inset -4px 0 0 rgb(0 0 0 / 0.12);
    transition: transform 0.55s var(--ease-out);
    will-change: transform;
  }
  .spine:hover,
  .spine:focus-visible,
  .spine:global(.is-pulled) {
    transform: translateY(-26px) rotate(-1.5deg);
  }
  .c-ink {
    --c: #17140f;
    --t: #efe9dc;
  }
  .c-red {
    --c: #a82c18;
    --t: #f8f5ee;
  }
  .c-ochre {
    --c: #b88a2c;
    --t: #17140f;
  }
  .c-slate {
    --c: #2d3c5c;
    --t: #efe9dc;
  }
  .c-moss {
    --c: #3a5240;
    --t: #efe9dc;
  }
  .c-paper {
    --c: #e3dccb;
    --t: #17140f;
  }
  .band {
    width: 100%;
    height: 10px;
    border-block: 1px solid currentColor;
    opacity: 0.45;
  }
  .sp-title {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.05;
    max-height: 72%;
    overflow: hidden;
    text-align: start;
    padding-inline: 6px;
  }
  .sp-code {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.6rem;
    opacity: 0.75;
    max-height: 22%;
    overflow: hidden;
  }
  .board {
    height: 14px;
    background: var(--fg);
    border-radius: 0 0 2px 2px;
    box-shadow: 0 18px 30px -18px rgb(23 20 15 / 0.6);
  }
  .preview {
    min-height: 0;
  }
  .card {
    display: grid;
    grid-template-columns: minmax(120px, 2fr) 3fr;
    gap: clamp(16px, 2.4vw, 32px);
    align-items: end;
    animation: card-in 0.6s var(--ease-out);
  }
  .card[hidden] {
    display: none;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .cover {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    transform: rotate(-2deg);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .meta {
    display: grid;
    gap: 10px;
  }
  .meta h3 {
    font-size: clamp(1.6rem, 2.4vw, 2.3rem);
    line-height: 1.04;
  }
  .meta h3 a:hover {
    color: var(--accent);
  }
  .by {
    color: var(--fg-muted);
  }
  .facts {
    font-size: 0.6875rem;
  }
</style>
