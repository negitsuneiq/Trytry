---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { t, type Lang } from '../../i18n/strings';
import { asset } from '../../lib/paths';
import { typeCounts, samplesOfType } from '../../lib/home';
import type { DocType } from '../../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const types: DocType[] = ['lecture-notes', 'problem-set', 'exam', 'book'];
const small = (id: string) => `thumbs/sm/${id}.webp`;
const has = (id: string) => existsSync(join(process.cwd(), 'public', small(id)));
---

<section class="scene def-scene" data-scene="definition" data-label={s.home.margin.definition} aria-labelledby="def-h">
  <div class="def-stage" data-def-stage>
    <div class="wrap grid">
      <div class="text">
        <h2 id="def-h" class="thm">{s.home.defLabel} <b>1.</b></h2>
        <p class="def display" data-def>
          {
            s.home.definition.map((seg) =>
              'term' in seg && seg.term ? (
                <span class="term" data-term={seg.term}>
                  {seg.t}
                  <svg class="pencil" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M3 9 C 38 4, 74 12, 112 7 S 172 4, 197 8" pathLength="1" />
                  </svg>
                </span>
              ) : (
                seg.t
              ),
            )
          }
        </p>
      </div>

      <dl class="tally">
        {
          types.map((ty) => (
            <div class="row" data-tally={ty}>
              <dt class="mono">{s.types[ty]}</dt>
              <dd class="display n">{typeCounts[ty]}</dd>
              <dd class="fan" aria-hidden="true">
                {samplesOfType(ty).map((d, i) =>
                  has(d.id) ? <img class="sheet" src={asset(small(d.id))} alt="" width="240" height="320" loading="lazy" decoding="async" style={`--i:${i}`} /> : null,
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .def-stage {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 40px) 64px;
  }
  .grid {
    display: grid;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
  }
  .text {
    display: grid;
    gap: clamp(20px, 3vw, 36px);
  }
  .def {
    font-size: clamp(1.9rem, 3.7vw, 3.75rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .term {
    position: relative;
    white-space: nowrap;
    font-style: italic;
  }
  .pencil {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: -0.12em;
    width: 104%;
    height: 0.32em;
    overflow: visible;
    pointer-events: none;
  }
  .pencil path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .js .def-scene:not(.is-static) .pencil path {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease-out);
  }
  .js .def-scene:not(.is-static) .term.is-on .pencil path {
    stroke-dashoffset: 0;
  }

  .tally {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: end;
    gap: 2px 16px;
    padding: 16px 0 18px;
    border-bottom: 1px solid var(--line);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  .js .def-scene:not(.is-static) .row:not(.is-on) {
    opacity: 0.28;
    transform: translateX(10px);
  }
  .row dt {
    color: var(--fg-muted);
  }
  .n {
    grid-row: 1 / 3;
    grid-column: 2;
    font-size: clamp(2.6rem, 4vw, 4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .row.is-on .n {
    color: var(--accent);
  }
  .fan {
    position: relative;
    height: 48px;
    margin-top: 8px;
  }
  .fan img {
    position: absolute;
    left: calc(var(--i) * 22px);
    bottom: 0;
    width: 36px;
    height: 48px;
    object-fit: cover;
    object-position: top;
    transform: rotate(calc((var(--i) - 1) * 6deg));
    transform-origin: 50% 100%;
    transition: transform 0.6s var(--ease-out);
  }
  .row.is-on .fan img {
    transform: rotate(calc((var(--i) - 1) * 10deg)) translateX(calc(var(--i) * 4px));
  }
  /* Phones: the sentence and the four counts must fit one pinned screen. */
  @media (max-width: 640px) {
    .def {
      font-size: clamp(1.45rem, 6.6vw, 2rem);
    }
    .tally {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }
    .row {
      padding: 10px 0 12px;
    }
    .n {
      font-size: 2.2rem;
    }
    .fan {
      display: none;
    }
  }
  :global(.def .w) {
    will-change: opacity;
  }
</style>
