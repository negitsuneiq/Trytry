---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { DocumentRecord } from '../lib/schema';
import { TOPIC_BY_SLUG } from '../lib/topics';
import { coverSvg, COVER_VIEWBOX } from '../lib/cover';
import { asset } from '../lib/paths';

interface Props {
  doc: DocumentRecord;
  eager?: boolean;
}
const { doc, eager = false } = Astro.props;
const thumb = `thumbs/${doc.id}.webp`;
const hasThumb = doc.hosted && existsSync(join(process.cwd(), 'public', thumb));
const topic = TOPIC_BY_SLUG.get(doc.topics[0] ?? '') ?? TOPIC_BY_SLUG.get('analysis')!;
---

<div class="cover" data-kind={hasThumb ? 'thumb' : 'art'}>
  {
    hasThumb ? (
      <img src={asset(thumb)} alt="" width="600" height="800" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <svg viewBox={COVER_VIEWBOX} preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={coverSvg(doc.id, topic.motif)} />
    )
  }
  <span class="code mono" aria-hidden="true">{doc.course_code ?? topic.msc[0] + '-XX'}</span>
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cover img,
  .cover svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition:
      transform 1.1s var(--ease-out),
      filter 0.6s;
  }
  .cover[data-kind='thumb'] img {
    filter: grayscale(1) contrast(1.05) brightness(0.85);
  }
  .cover svg {
    stroke-width: 1;
  }
  .code {
    position: absolute;
    left: 12px;
    top: 10px;
    color: var(--fg-faint);
    font-size: 0.625rem;
  }
</style>
