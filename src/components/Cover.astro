---
import '../styles/card.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { DocumentRecord } from '../lib/schema';
import { coverHtml, uniShort } from '../lib/cover';
import { shortTitle } from '../lib/short';
import { universityBySlug } from '../lib/data';
import { asset } from '../lib/paths';

interface Props {
  doc: DocumentRecord;
  eager?: boolean;
}
const { doc, eager = false } = Astro.props;
const thumb = `thumbs/${doc.id}.webp`;
const hasThumb = doc.hosted && existsSync(join(process.cwd(), 'public', thumb));
const label = doc.course_code ?? uniShort(doc.university, universityBySlug.get(doc.university)?.name);
---

<div class="cover" data-kind={hasThumb ? 'thumb' : 'type'}>
  {
    hasThumb ? (
      <>
        <img src={asset(thumb)} alt="" width="600" height="800" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        {doc.course_code && <span class="code mono" aria-hidden="true">{doc.course_code}</span>}
      </>
    ) : (
      <Fragment set:html={coverHtml({ id: doc.id, label, title: shortTitle(doc) ?? doc.title, authors: doc.authors })} />
    )
  }
</div>
