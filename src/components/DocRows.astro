---
// Compact, scannable rows for documents: course pages and the "related" list
// on a document page. One link per row, no thumbnails, so a 94-document course
// costs a few kilobytes instead of a wall of cards.
import type { DocumentRecord } from '../lib/schema';
import { t, type Lang } from '../i18n/strings';
import { href } from '../lib/paths';
import { inlineTex } from '../lib/math';
import { authorsLine } from '../lib/format';

interface Props {
  rows: { doc: DocumentRecord; label: string }[];
  lang: Lang;
  /** Authors already named in the page header; shown per row only when they differ. */
  instructors?: string[];
  /** Name the document type in each row (lists that mix types). */
  showType?: boolean;
  /** Accessible name of the list. */
  label?: string;
}
const { rows, lang, instructors, showType = false, label } = Astro.props;
const s = t(lang);
const known = new Set(instructors ?? []);
---

<ul class="rows" aria-label={label}>
  {
    rows.map(({ doc, label: lbl }) => {
      const author = doc.authors.length > 0 && (!instructors || doc.authors.some((a) => !known.has(a))) ? authorsLine(doc.authors) : null;
      const bits: string[] = [];
      if (showType) bits.push(s.types[doc.type]);
      if (doc.year) bits.push(String(doc.year));
      if (doc.pages) bits.push(s.course.pagesShort(doc.pages));
      return (
        <li>
          <a class="row" href={href(lang, `doc/${doc.id}`)}>
            <span class="lbl">
              <span class="t" set:html={inlineTex(lbl)} />
              {author && <span class="by">{author}</span>}
            </span>
            <span class="meta mono">
              {bits.length > 0 && <span>{bits.join(' · ')}</span>}
              {doc.hosted && (
                <span class="hosted" title={s.course.hostedLabel}>
                  <span class="dot" aria-hidden="true" />
                  <span aria-hidden="true">{s.course.hostedMark}</span>
                  <span class="sr-only">{s.course.hostedLabel}</span>
                </span>
              )}
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .rows li {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 20px;
    align-items: baseline;
    padding: 11px 6px;
    margin-inline: -6px;
    transition: background-color 0.2s;
  }
  .row:hover,
  .row:focus-visible {
    background: var(--bg-raised);
  }
  .row:focus-visible {
    outline-offset: -2px;
  }
  .lbl {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    align-items: baseline;
    min-width: 0;
  }
  .t {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .row:hover .t,
  .row:focus-visible .t {
    color: var(--accent);
  }
  .by {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .meta {
    display: inline-flex;
    gap: 14px;
    align-items: baseline;
    justify-content: flex-end;
    color: var(--fg-muted);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  .hosted {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--fg);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (max-width: 559px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .meta {
      justify-content: flex-start;
    }
  }
</style>
