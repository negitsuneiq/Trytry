---
import { t, type Lang } from '../i18n/strings';
import { href } from '../lib/paths';
import { universities } from '../lib/data';
import { SITE } from '../site.config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const ranking = universities[0];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="rule-ticks" aria-hidden="true"></div>
    <div class="cols">
      <div class="lead">
        <p class="display tag">{s.footer.tagline}</p>
        <p class="mono muted">{s.footer.noAds}</p>
      </div>
      <nav aria-label={s.a11y.navFooter}>
        <ul>
          <li><a href={href(lang, 'library')}>{s.nav.library}</a></li>
          <li><a href={href(lang, 'universities')}>{s.nav.universities}</a></li>
          <li><a href={href(lang, 'topics')}>{s.nav.topics}</a></li>
          <li><a href={href(lang, 'about')}>{s.nav.about}</a></li>
          <li><a href={href(lang, 'license')}>{s.nav.license}</a></li>
        </ul>
      </nav>
      <div class="meta mono-plain muted">
        {
          ranking && (
            <p>
              {s.footer.rankingCredit}:{' '}
              <a class="u" href={ranking.ranking_url} rel="noopener">
                {ranking.ranking_source} {ranking.ranking_year}
              </a>
            </p>
          )
        }
        <p>
          <a class="u" href={SITE.repo} rel="noopener">{s.footer.built}</a>
        </p>
      </div>
    </div>
    <p class="wordmark display" aria-hidden="true">Open <em>Lemma</em><span class="qed">∎</span></p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(64px, 10vw, 120px);
    overflow: hidden;
  }
  .cols {
    display: grid;
    gap: 40px;
    padding-top: 40px;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 6fr 3fr 3fr;
    }
  }
  .tag {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 1.05;
    max-width: 16ch;
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  ul a {
    display: inline-block;
    padding: 6px 0;
    color: var(--fg-muted);
    transition: color 0.3s;
  }
  ul a:hover {
    color: var(--fg);
  }
  .meta {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .u {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .u:hover {
    color: var(--fg);
  }
  .wordmark {
    font-size: clamp(4rem, 19vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    margin-top: clamp(48px, 8vw, 96px);
    margin-bottom: -0.12em;
    white-space: nowrap;
    color: var(--fg);
    opacity: 0.95;
  }
  .qed {
    font-size: 0.3em;
    color: var(--accent);
    margin-left: 0.12em;
  }
</style>
