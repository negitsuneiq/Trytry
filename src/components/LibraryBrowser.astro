---
import CardConfig from './CardConfig.astro';
import LoadMore from './LoadMore.astro';
import EmptyState from './EmptyState.astro';
import { t, type Lang } from '../i18n/strings';
import { documents, universities, usedTopics } from '../lib/data';
import { TOPICS } from '../lib/topics';
import { DOC_TYPES, LEVELS, licenseLabel, type License } from '../lib/schema';
import { courses } from '../lib/courses';
import { courseCfg } from '../lib/courseCfg';

interface Props {
  lang: Lang;
  /** Mirror search, filters and sort into the address bar (the /library/ page). */
  urlState?: boolean;
  /** Heading level of the cards: below the page's own headings. */
  cardHeading?: 'h2' | 'h3';
  /** Which view is shown without a `v` parameter; default: courses on the library page, documents embedded. */
  defaultView?: 'courses' | 'docs';
}
const { lang, urlState = false, cardHeading = 'h2' } = Astro.props;
const s = t(lang);

const topicOptions = usedTopics.length ? usedTopics : TOPICS;
const uniOptions = universities.filter((u) => documents.some((d) => d.university === u.slug));
const licenses = [...new Set(documents.map((d) => d.license))].sort() as License[];
const types = DOC_TYPES.filter((ty) => documents.some((d) => d.type === ty));
const defaultView = Astro.props.defaultView ?? (urlState ? 'courses' : 'docs');
const hasCourses = courses.length > 0;
const cc = courseCfg(s);

const groups = [
  { key: 'u', label: s.library.university, options: uniOptions.map((u) => ({ value: u.slug, label: u.name, en: true })) },
  { key: 't', label: s.library.topic, options: topicOptions.map((tp) => ({ value: tp.slug, label: tp[lang] })) },
  { key: 'l', label: s.library.level, options: LEVELS.map((l) => ({ value: l, label: s.levels[l] })) },
  { key: 'ty', label: s.library.type, options: types.map((ty) => ({ value: ty, label: s.types[ty] })) },
  { key: 'li', label: s.library.license, options: licenses.map((l) => ({ value: l, label: licenseLabel(l, s.licenseStatus) })) },
].filter((g) => g.options.length > 0);
---

{
  documents.length === 0 ? (
    <EmptyState lang={lang} />
  ) : (
    <div class="lib" data-library data-url-state={urlState ? "1" : undefined} data-card-heading={cardHeading} data-default-view={hasCourses ? defaultView : 'docs'}>
      <div class="searchbar">
        <label class="search">
          <span class="sr-only">{s.library.search}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.4" />
          </svg>
          <input type="search" name="q" placeholder={s.library.searchPlaceholder} autocomplete="off" enterkeyhint="search" data-q />
        </label>
        <div class="fs" data-fs>
          <button class="btn btn-sm fs-toggle" type="button" aria-expanded="false" aria-controls="lib-panel" data-fs-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h10M18 7h2M4 17h2M10 17h10" fill="none" stroke="currentColor" stroke-width="1.5" />
              <circle cx="16" cy="7" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
              <circle cx="8" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span>{s.library.filterSort}</span>
            <span class="badge mono" data-active-count hidden />
          </button>

          <div id="lib-panel" class="panel" role="dialog" aria-label={s.library.filterSort} tabindex="-1" hidden data-panel>
            <div class="panel-head">
              <h2 class="mono">{s.library.filterSort}</h2>
              <button class="close" type="button" aria-label={s.a11y.close} data-fs-close>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
            </div>

            <div class="panel-body">
              <fieldset class="group">
                <legend class="mono">{s.library.sort}</legend>
                <div class="opts">
                  {[
                    ['relevance', s.library.sortRelevance, ''],
                    ['newest', s.library.sortNewest, 'd'],
                    ['size', s.library.sortSize, 'c'],
                    ['title', s.library.sortTitle, ''],
                    ['rank', s.library.sortRank, ''],
                  ].map(([value, label, only], i) => (
                    <label class="opt" data-view-only={only || undefined} hidden={only === 'c'}>
                      <input type="radio" name="s" value={value} checked={i === 0} data-sort />
                      <span>{label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="switch">
                <input type="checkbox" data-hosted />
                <span class="track" aria-hidden="true">
                  <span class="thumb" />
                </span>
                <span>{s.library.hostedOnly}</span>
              </label>

              {groups.map((g) => (
                <fieldset class="group" data-view-only={g.key === 'li' ? 'd' : undefined}>
                  <legend class="mono">{g.label}</legend>
                  <div class="opts">
                    {g.options.map((o) => (
                      <label class="opt">
                        <input type="checkbox" name={g.key} value={o.value} data-facet={g.key} />
                        <span lang={'en' in o ? 'en' : undefined}>{o.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>

            <div class="panel-foot">
              <button class="btn btn-sm" type="button" data-clear>
                {s.library.clear}
              </button>
              <button class="btn btn-sm btn-primary" type="button" data-fs-close data-show-results data-template-one={s.library.showResults(1)} data-template={s.library.showResults(2)} data-template-one-c={s.library.showCourses(1)} data-template-c={s.library.showCourses(2)}>
                {s.library.showResults(documents.length)}
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="status">
        {
          hasCourses && (
            <div class="seg mono" role="group" aria-label={s.library.viewLabel} data-view-switch>
              <button type="button" data-view="courses" aria-pressed={defaultView === 'courses' ? 'true' : 'false'}>{s.library.viewCourses}</button>
              <button type="button" data-view="docs" aria-pressed={defaultView === 'docs' ? 'true' : 'false'}>{s.library.viewDocs}</button>
            </div>
          )
        }
        <p class="mono muted count" aria-live="polite" data-count-label data-template-one={s.library.results(1)} data-template={s.library.results(2)} data-template-one-c={s.library.courseResults(1)} data-template-c={s.library.courseResults(2)}>
          {defaultView === 'courses' && hasCourses ? s.library.courseResults(courses.length) : s.library.results(documents.length)}
        </p>
        <ul class="active" data-active data-remove={s.library.removeFilter} />
      </div>

      <div class="results">
        <section class="course-strip" aria-label={s.library.stripTitle} hidden data-strip>
          <div class="strip-h">
            <h2 class="mono">{s.library.stripTitle} <span class="muted" data-strip-n></span></h2>
            <button class="mono link-u" type="button" data-strip-all data-template={s.library.stripAll(0)} hidden></button>
          </div>
          <ul data-strip-list></ul>
        </section>
        <div class="grid" data-grid data-mode={hasCourses ? defaultView : 'docs'} aria-busy="true">
          {Array.from({ length: 12 }, () => (
            <div class="sk" aria-hidden="true" />
          ))}
        </div>
        <noscript>
          <p class="none">{s.pager.noscript}</p>
        </noscript>
        <LoadMore lang={lang} />
        <div class="none" hidden data-none>
          <p class="none-t" data-none-msg>{s.library.noResults}</p>
          <p class="none-h" data-none-extra>{s.library.noResultsHint}</p>
          <div class="none-act" data-none-extra>
            <button class="btn btn-sm" type="button" data-clear-q hidden>{s.library.clearSearch}</button>
            <button class="btn btn-sm" type="button" data-clear-f hidden>{s.library.clear}</button>
          </div>
        </div>
      </div>
      <CardConfig lang={lang} />
      {hasCourses && <script type="application/json" id="course-cfg" set:html={JSON.stringify(cc)} />}
    </div>
  )
}

<script>
  import { initLibrary } from '../scripts/library';
  document.addEventListener('astro:page-load', initLibrary);
</script>

<style>
  /* Grid, not wrapping flex: rows stay put while fonts load (no CLS). */
  .searchbar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px clamp(14px, 2vw, 28px);
    padding: 14px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s;
  }
  .search:focus-within {
    border-color: var(--accent);
  }
  .search svg {
    width: 22px;
    height: 22px;
    color: var(--fg-muted);
    flex: none;
  }
  .search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    padding: 8px 0;
  }
  .search input::placeholder {
    color: var(--fg-faint);
  }

  /* Filter & sort: one control, one panel. Needs JS, so it is hidden without it. */
  html:not(.js) .fs {
    display: none;
  }
  .fs-toggle {
    white-space: nowrap;
    gap: 10px;
    --h: 44px;
  }
  .fs-toggle svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.6875rem;
  }
  .badge[hidden] {
    display: none;
  }
  .fs-toggle:hover .badge,
  .fs-toggle:focus-visible .badge {
    background: var(--accent-ink);
    color: var(--accent);
  }
  .fs-toggle[aria-expanded='true'] {
    border-color: var(--fg);
  }
  .panel {
    position: absolute;
    top: calc(100% - 2px);
    right: 0;
    z-index: 80;
    width: min(720px, 100%);
    max-height: calc(100vh - var(--header-h) - 120px);
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-sheet);
  }
  .panel[hidden] {
    display: none;
  }
  .panel:focus {
    outline: 0;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px 6px 24px;
    border-bottom: 1px solid var(--line);
  }
  .panel-head h2 {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--fg-muted);
  }
  .close:hover {
    color: var(--accent);
  }
  .close svg {
    width: 20px;
    height: 20px;
  }
  .panel-body {
    display: grid;
    gap: 26px;
    padding: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .panel-foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 24px;
    border-top: 1px solid var(--line);
  }
  .group {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    color: var(--fg-muted);
    margin-bottom: 12px;
    padding: 0;
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .opt {
    position: relative;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .opt span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--fg-muted);
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .opt:hover span {
    color: var(--fg);
    border-color: var(--fg-muted);
  }
  .opt input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .opt input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .switch {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    position: relative;
    font-size: 0.92rem;
  }
  .switch input {
    position: absolute;
    opacity: 0;
    width: 44px;
    height: 26px;
  }
  .track {
    width: 44px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    position: relative;
    flex: none;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--fg-muted);
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s;
  }
  .switch input:checked + .track {
    background: var(--accent);
    border-color: var(--accent);
  }
  .switch input:checked + .track .thumb {
    transform: translateX(18px);
    background: var(--accent-ink);
  }
  .switch input:focus-visible + .track {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Narrow phones: the search field gets a full-width line of its own. */
  @media (max-width: 640px) {
    .searchbar {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 10px 0;
    }
    .search input {
      font-size: 1.35rem;
    }
    .fs-toggle {
      --h: 40px;
      justify-self: start;
    }
  }
  /* On phones the panel is a full-width sheet under the header. */
  @media (max-width: 719px) {
    .panel {
      position: fixed;
      inset: var(--header-h) 0 0;
      width: auto;
      max-height: none;
      border-width: 1px 0 0;
      box-shadow: none;
    }
    .panel-head {
      padding-left: var(--gutter);
    }
    .panel-body {
      padding: 20px var(--gutter);
    }
    .panel-foot {
      padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom));
    }
    .panel-foot .btn {
      flex: 1;
      justify-content: center;
    }
  }

  /* Count and removable chips share one row; min-height keeps it from jumping. */
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    min-height: 34px;
    margin: 16px 0 24px;
  }
  /* View switch: the same pill as the language switch in the header. */
  .seg {
    display: inline-flex;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }
  html:not(.js) .seg {
    display: none;
  }
  .seg button {
    height: 28px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--fg-muted);
    white-space: nowrap;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .seg button:hover {
    color: var(--fg);
  }
  .seg button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }
  .seg button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .active {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .active :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px 0 14px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-size: 0.82rem;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .active :global(button:hover),
  .active :global(button:focus-visible) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .active :global(svg) {
    width: 10px;
    height: 10px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px) clamp(14px, 2.4vw, 28px);
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1500px) {
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .grid > :global([hidden]) {
    display: none;
  }
  .opt[hidden],
  .group[hidden] {
    display: none;
  }
  /* Phones: single column of compact cards (see styles/card.css). */
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .sk {
      aspect-ratio: auto;
      height: 149px;
      border-width: 0 0 1px;
    }
  }
  /* Placeholder cards until the index arrives: same cell shape, so nothing jumps. */
  .grid[data-mode='c'] .sk {
    aspect-ratio: auto;
    height: 210px;
  }
  .sk {
    aspect-ratio: 3 / 4;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  html:not(.js) .sk {
    display: none;
  }
  .none {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding: 40px 0 56px;
  }
  .none[hidden] {
    display: none;
  }
  .none-t {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--fg-muted);
  }
  .none-h {
    max-width: 54ch;
    color: var(--fg-muted);
  }
  .none-act {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }
  .none-act [hidden] {
    display: none;
  }
</style>
