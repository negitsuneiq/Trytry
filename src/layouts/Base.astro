---
import { ClientRouter } from 'astro:transitions';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/strings';
import { swapLang, asset } from '../lib/paths';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifLatinExt from '@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const s = t(lang);
const fullTitle = title ? `${title} — ${s.meta.title}` : `${s.meta.title} — ${s.hero.eyebrow}`;
const desc = description ?? s.meta.description;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const alt = (l: Lang) => new URL(swapLang(path, l), Astro.site).href;
// The display face draws the LCP headline; Turkish text also needs latin-ext.
const preloadFonts = lang === 'tr' ? [serifLatin, serifLatinExt] : [serifLatin];
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="tr" href={alt('tr')} />
    <link rel="alternate" hreflang="x-default" href={new URL(asset(''), Astro.site).href} />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    {preloadFonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{s.a11y.skip}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="cursor" aria-hidden="true" transition:persist="cursor">
      <span class="cursor-ring"></span>
      <span class="cursor-dot"></span>
      <span class="cursor-label"></span>
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
